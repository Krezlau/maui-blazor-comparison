<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MgrCode.XamlApp.MainPage"
             xmlns:backendModels="clr-namespace:MgrCode.Backend.Models;assembly=MgrCode.Backend"
             Title="Crypto Dashboard">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="8">

        <Label Text="{Binding Status}" FontAttributes="Bold" />

        <Label Grid.Row="1" Text="{Binding UpdatesReceived, StringFormat='Updates: {0}'}" />

        <HorizontalStackLayout Grid.Row="2" Spacing="8">
            <Button Text="Initialize" Command="{Binding InitializeCommand}" />
            <Button Text="Start" Command="{Binding StartCommand}" />
            <Button Text="Stop" Command="{Binding StopCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Tickers}" SelectionMode="None">
            <CollectionView.Header>
                <Grid ColumnDefinitions="4*,5*,4*,4*" Padding="4">
                    <Label Text="Symbol" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Price" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Change" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="Volume" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="backendModels:Ticker">
                    <Grid ColumnDefinitions="4*,5*,4*,4*" Padding="4">
                        <Label Text="{Binding Symbol}" />
                        <Label Grid.Column="1" Text="{Binding LastPrice, StringFormat='{0:F8}'}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="{Binding Price24hPcnt, StringFormat='{0:0.00%}'}" HorizontalTextAlignment="End">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Direction}" Value="Up">
                                    <Setter Property="TextColor" Value="Green" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Direction}" Value="Down">
                                    <Setter Property="TextColor" Value="Red" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="3" Text="{Binding Volume24h, StringFormat='{0:F2}'}" HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
