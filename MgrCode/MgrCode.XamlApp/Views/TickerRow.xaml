<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MgrCode.XamlApp.Views.TickerRow">

    <Grid ColumnDefinitions="2.2*,1.5*,1.1*,1.3*,1.7*,1.7*,1.3*"
          Padding="4,7"
          ColumnSpacing="6">

        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
            <Ellipse x:Name="Dot" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
            <Label x:Name="SymbolLabel" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Label x:Name="LastLabel" Grid.Column="1" FontSize="12" VerticalOptions="Center"
               HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />

        <Border x:Name="PctBadge" Grid.Column="2" StrokeThickness="0" Padding="4,1" VerticalOptions="Center"
                HorizontalOptions="End" StrokeShape="RoundRectangle 8">
            <Label x:Name="PctLabel" FontSize="11" VerticalOptions="Center" HorizontalTextAlignment="End" />
        </Border>

        <Label x:Name="VolumeLabel" Grid.Column="3" FontSize="12" VerticalOptions="Center"
               HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />

        <Label x:Name="HighLowLabel" Grid.Column="4" FontSize="11" VerticalOptions="Center"
               HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />

        <Label x:Name="BidAskLabel" Grid.Column="5" FontSize="11" VerticalOptions="Center"
               HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />

        <GraphicsView x:Name="Sparkline" Grid.Column="6" HeightRequest="32" WidthRequest="90"
                      VerticalOptions="Center" HorizontalOptions="Start" InputTransparent="True" />

    </Grid>

</ContentView>