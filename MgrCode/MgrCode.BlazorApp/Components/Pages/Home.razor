@page "/"
@using MgrCode.Backend.Models
@using MgrCode.Backend.ViewModels
@inject CryptoDashboardViewModel Vm

<h1>Crypto Dashboard</h1>

<p><strong>@Vm.Status</strong></p>
<p>Updates: @Vm.UpdatesReceived</p>

<div class="btn-group mb-3">
    <button class="btn btn-primary" @onclick="() => Vm.InitializeCommand.Execute(null)">Initialize</button>
    <button class="btn btn-success" @onclick="() => Vm.StartCommand.Execute(null)">Start</button>
    <button class="btn btn-secondary" @onclick="() => Vm.StopCommand.Execute(null)">Stop</button>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Price</th>
                <th>Change</th>
                <th>Volume</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Vm.Tickers)
            {
                <tr>
                    <td>@t.Symbol</td>
                    <td>@t.LastPrice.ToString("F8")</td>
                    <td class="@(t.Direction == PriceDirection.Up ? "text-success" : t.Direction == PriceDirection.Down ? "text-danger" : string.Empty)">
                        @t.Price24hPcnt.ToString("0.00%")
                    </td>
                    <td>@t.Volume24h.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Vm.IsInitialized)
            await Vm.InitializeCommand.ExecuteAsync(null);
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        while (true)
        {
            try
            {
                await Task.Delay(250);
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                break;
            }
        }
    }
}
