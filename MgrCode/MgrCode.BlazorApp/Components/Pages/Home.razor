@page "/"
@using MgrCode.Backend.ViewModels
@inject MainViewModel ViewModel

<h1>Hello, World from Blazor!</h1>

<p role="status">@ViewModel.CountText</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<h3 class="mt-4">Todo Items</h3>

<div class="input-group mb-3">
    <input @bind="ViewModel.NewTodoTitle" type="text" class="form-control" placeholder="Add a todo..." />
    <button class="btn btn-outline-secondary" @onclick="AddTodo">Add</button>
</div>

@if (ViewModel.TodoItems.Count == 0)
{
    <p class="text-muted">No todos yet. Add one above!</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in ViewModel.TodoItems)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <input type="checkbox" checked="@item.IsCompleted"
                           @onchange="() => ToggleTodo(item)" />
                    <span class="ms-2" style="text-decoration: @(item.IsCompleted ? "line-through" : "none")">@item.Title</span>
                </div>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteTodo(item)">Delete</button>
            </li>
        }
    </ul>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadTodosCommand.ExecuteAsync(null);
    }

    private void IncrementCount()
    {
        ViewModel.IncrementCountCommand.Execute(null);
    }

    private async Task AddTodo()
    {
        await ViewModel.AddTodoCommand.ExecuteAsync(null);
    }

    private async Task ToggleTodo(MgrCode.Backend.Models.TodoItem item)
    {
        await ViewModel.ToggleTodoCommand.ExecuteAsync(item);
    }

    private async Task DeleteTodo(MgrCode.Backend.Models.TodoItem item)
    {
        await ViewModel.DeleteTodoCommand.ExecuteAsync(item);
    }
}
